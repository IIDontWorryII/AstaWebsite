# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` documents what variables the app expects.

# SQLite file path for Prisma. Relative paths resolve from server/prisma/.
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotate to invalidate every issued JWT (force-logout all users).
JWT_SECRET="replace-me-with-a-long-random-string"
