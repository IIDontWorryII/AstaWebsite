# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` documents what variables the app expects.

# PostgreSQL connection string for Prisma. We use Neon (free tier) — sign
# up at https://neon.tech and copy the pooled connection string from the
# project dashboard. The "-pooler" hostname is the pooled URL.
#
# DATABASE_URL  = POOLED   — used by the app at runtime.
# DIRECT_URL    = UNPOOLED — used by `prisma migrate`. Same as the pooled
#                            URL but with "-pooler" removed from the hostname.
DATABASE_URL="postgresql://USER:PASSWORD@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-something.region.aws.neon.tech/neondb?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotate to invalidate every issued JWT (force-logout all users).
JWT_SECRET="replace-me-with-a-long-random-string"

# Allowed origins for cross-origin requests, comma-separated.
# REQUIRED in production (NODE_ENV=production). Ignored in development
# (dev allows any origin so Vite, Postman, and curl all work).
#
# Example:
#   CORS_ORIGIN=https://asta-remagen.de,https://www.asta-remagen.de
CORS_ORIGIN=""

# Set to "production" on real deployments. Locally, leave unset or use
# "development". Switching to production enables stricter cookie security
# (secure: true) and requires CORS_ORIGIN to be set.
NODE_ENV="development"

# ─── Cloudflare R2 object storage ─────────────────────────────────────
#
# Required in BOTH dev and prod — all uploaded files (event posters,
# protocol PDFs) live in R2 so they persist across server restarts.
# Sign up at https://cloudflare.com, enable R2, create a bucket with
# public access, and generate an API token. See AW-41 docs for the full
# setup walk-through.

# S3-compatible endpoint URL for your R2 account.
# Looks like: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Name of the bucket you created.
R2_BUCKET="astawebsite-uploads"

# API token credentials (from the R2 dashboard → Manage API Tokens).
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."

# Public URL of the bucket (R2.dev subdomain or your custom domain).
# The frontend uses this directly to fetch uploaded files — no proxy.
# Looks like: https://pub-<hash>.r2.dev
R2_PUBLIC_URL="https://pub-yourbucket.r2.dev"

# ─── SAML SSO (log in with HS Koblenz) ────────────────────────────────
#
# Our Service Provider (SP) side. Generate the keypair once with:
#   openssl req -x509 -newkey rsa:2048 -keyout saml-sp-key.pem \
#     -out saml-sp-cert.pem -days 3650 -nodes -subj "/CN=asta-rac.de"
# Keep saml-sp-key.pem SECRET (never commit it).
SAML_SP_ENTITY_ID="https://asta-rac.de/saml/metadata"
SAML_SP_ACS_URL="https://asta-rac.de/api/auth/saml/acs"
SAML_SP_SLO_URL="https://asta-rac.de/api/auth/saml/slo"
# Point these at the generated files (or inline the PEM in SAML_SP_CERT).
SAML_SP_CERT_FILE="./saml-sp-cert.pem"
SAML_SP_KEY_FILE="./saml-sp-key.pem"

# Our IdP (HS Koblenz) side — fill in once Jonas sends the IdP metadata.
# Needed for the login/ACS flow (Slice 2), not for emitting SP metadata.
SAML_IDP_ENTITY_ID=""
SAML_IDP_SSO_URL=""
SAML_IDP_CERT=""
