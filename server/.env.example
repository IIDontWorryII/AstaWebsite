# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` documents what variables the app expects.

# PostgreSQL connection string for Prisma. We use Neon (free tier) — sign
# up at https://neon.tech and copy the pooled connection string from the
# project dashboard. The "-pooler" hostname is the pooled URL.
#
# DATABASE_URL  = POOLED   — used by the app at runtime.
# DIRECT_URL    = UNPOOLED — used by `prisma migrate`. Same as the pooled
#                            URL but with "-pooler" removed from the hostname.
DATABASE_URL="postgresql://USER:PASSWORD@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-something.region.aws.neon.tech/neondb?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotate to invalidate every issued JWT (force-logout all users).
JWT_SECRET="replace-me-with-a-long-random-string"

# Allowed origins for cross-origin requests, comma-separated.
# REQUIRED in production (NODE_ENV=production). Ignored in development
# (dev allows any origin so Vite, Postman, and curl all work).
#
# Example:
#   CORS_ORIGIN=https://asta-remagen.de,https://www.asta-remagen.de
CORS_ORIGIN=""

# Set to "production" on real deployments. Locally, leave unset or use
# "development". Switching to production enables stricter cookie security
# (secure: true) and requires CORS_ORIGIN to be set.
NODE_ENV="development"
