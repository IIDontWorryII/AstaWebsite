// This is your Prisma schema file.
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL is used in both dev and production. Local dev points at a
  // Neon free-tier database; production will point at a separate Neon
  // database (set up later in the deploy slice).
  //
  // url       = POOLED connection used by the app at runtime.
  // directUrl = UNPOOLED connection used only by `prisma migrate`; the
  //             pooler doesn't support some DDL operations during migrations.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String
  role         String     @default("USER")
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  favorites    Favorite[]
}

model Event {
  id          String     @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  price       String?
  place       String
  // Which group/referat the event belongs to (BARACKE, EVENT, SPORT,
  // FS_WISO, FS_MIT). Drives the per-referat "upcoming events" sections.
  // Free string validated app-side (see shared/types EVENT_CATEGORIES) so
  // new referate don't require a migration. Nullable for legacy rows.
  category    String?
  // If set, the event requires registration by email — the public detail
  // popup shows a "Sich anmelden" button linking to this address.
  registrationEmail String?
  startsAt    DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt()
  favorites   Favorite[]
}

// A user's bookmarked event ("Merkliste"). One row per (user, event) pair.
// Cascades on delete so removing a user or event cleans up its favorites.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Page {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  intro        String?
  // Optional hero background image, editable per page in admin. Falls back
  // to a bundled default in the page component when null.
  heroImageUrl String?
  sections     PageSection[]
}

model PageSection {
  id       String          @id @default(uuid())
  order    Int
  // `kind` tells the frontend how to render the section. Different kinds
  // surface different field sets in the public view and in the admin
  // editor (e.g. REFERAT shows photo + holder + email, INFO doesn't).
  kind     PageSectionKind
  subtitle String?
  body     String?
  imageUrl String?
  caption  String?
  email    String?
  pageId   String
  page     Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// Kinds of sections we know how to render. New entries should be added
// here AND get their own renderer + editor on the frontend.
//   INFO       — image + body paragraph. One per page (singleton).
//   REFERAT    — a single Referat card. ASTA has many; UI lets editor
//                add/remove.
//   MITGLIEDER — image + body. Used by STUPA for the bulk "Mitglieder"
//                text block (list of names in one paragraph).
//   FREEFORM   — subtitle + body. Used by Fachschaften for MIT/WISO.
//   MEMBER     — individual member portrait card: photo + role (subtitle)
//                + name (caption) + optional bio (body). Used by STUPA
//                for Präsident / Vizepräsident; can be reused anywhere
//                an individual person needs to be showcased.
//   MENU       — a single menu image (e.g. one page of the Getränkekarte).
//                Image-only (+ optional caption). Multi-instance: BaRACke
//                shows two side by side.
//   GALLERY    — a single gallery photo (image-only + optional caption).
//                Multi-instance, rendered as a photo grid. Used by BaRACke.
enum PageSectionKind {
  INFO
  REFERAT
  MITGLIEDER
  FREEFORM
  MEMBER
  MENU
  GALLERY
}

model Protocol {
  id          String   @id @default(uuid())
  gremium     String
  title       String
  description String?
  meetingDate DateTime
  fileUrl     String
  uploadedAt  DateTime @default(now())
}
