// This is your Prisma schema file.
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL is used in both dev and production. Local dev points at a
  // Neon free-tier database; production will point at a separate Neon
  // database (set up later in the deploy slice).
  //
  // url       = POOLED connection used by the app at runtime.
  // directUrl = UNPOOLED connection used only by `prisma migrate`; the
  //             pooler doesn't support some DDL operations during migrations.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         String    @default("USER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  price       String?
  place       String
  startsAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
}

model Page {
  id       String        @id @default(uuid())
  slug     String        @unique
  title    String
  intro    String?
  sections PageSection[]
}

model PageSection {
  id       String          @id @default(uuid())
  order    Int
  // `kind` tells the frontend how to render the section. Different kinds
  // surface different field sets in the public view and in the admin
  // editor (e.g. REFERAT shows photo + holder + email, INFO doesn't).
  kind     PageSectionKind
  subtitle String?
  body     String?
  imageUrl String?
  caption  String?
  email    String?
  pageId   String
  page     Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// Kinds of sections we know how to render. New entries should be added
// here AND get their own renderer + editor on the frontend.
//   INFO       — image + body paragraph. One per page (singleton).
//   REFERAT    — a single Referat card. ASTA has many; UI lets editor
//                add/remove.
//   MITGLIEDER — image + body. Used by STUPA for the bulk "Mitglieder"
//                text block (list of names in one paragraph).
//   FREEFORM   — subtitle + body. Used by Fachschaften for MIT/WISO.
//   MEMBER     — individual member portrait card: photo + role (subtitle)
//                + name (caption) + optional bio (body). Used by STUPA
//                for Präsident / Vizepräsident; can be reused anywhere
//                an individual person needs to be showcased.
//   MENU       — a single menu image (e.g. one page of the Getränkekarte).
//                Image-only (+ optional caption). Multi-instance: BaRACke
//                shows two side by side.
//   GALLERY    — a single gallery photo (image-only + optional caption).
//                Multi-instance, rendered as a photo grid. Used by BaRACke.
enum PageSectionKind {
  INFO
  REFERAT
  MITGLIEDER
  FREEFORM
  MEMBER
  MENU
  GALLERY
}

model Protocol {
  id          String   @id @default(uuid())
  gremium     String
  title       String
  meetingDate DateTime
  fileUrl     String
  uploadedAt  DateTime @default(now())
}
