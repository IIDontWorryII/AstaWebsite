// This is your Prisma schema file.
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         String    @default("USER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  price       String?
  place       String
  startsAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
}

model Page {
  id       String        @id @default(uuid())
  slug     String        @unique
  title    String
  intro    String?
  sections PageSection[]
}

model PageSection {
  id       String  @id @default(uuid())
  order    Int
  subtitle String?
  body     String?
  imageUrl String?
  caption  String?
  email    String?
  pageId   String
  page     Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Protocol {
  id          String   @id @default(uuid())
  gremium     String
  title       String
  meetingDate DateTime
  fileUrl     String
  uploadedAt  DateTime @default(now())
}
